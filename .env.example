# Copy this file to .env and fill it in. .env is ignored by git - never commit passwords.

# MetaTrader 5 (leave empty to use the account already logged in to the terminal)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Only needed if MT5 is not installed in the default folder
MT5_PATH=

# Optional: Twelve Data API key (for paper trading / backtesting without MT5)
TWELVE_DATA_API_KEY=
